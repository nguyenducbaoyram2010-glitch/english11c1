  <title>Grade 11 English Listening Test</title>
  <style>
    :root {
      --bg: #f4f7fb;
      --card: #ffffff;
      --ink: #182235;
      --muted: #68758a;
      --primary: #3858d6;
      --primary-dark: #2844b5;
      --line: #e1e7f0;
      --good: #137547;
      --good-bg: #eaf8f0;
      --bad: #b42318;
      --bad-bg: #fff0ef;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: radial-gradient(circle at top left, #e8edff 0, transparent 38%), var(--bg);
      color: var(--ink);
      font-family: Arial, Helvetica, sans-serif;
      line-height: 1.55;
    }
    .page { width: min(920px, calc(100% - 28px)); margin: 32px auto 56px; }
    .hero {
      padding: 30px;
      border-radius: 22px;
      color: white;
      background: linear-gradient(135deg, #263fae, #6478ee);
      box-shadow: 0 14px 35px rgba(48, 68, 170, .18);
    }
    .eyebrow { font-size: .78rem; letter-spacing: .13em; text-transform: uppercase; opacity: .85; font-weight: 700; }
    h1 { margin: 8px 0; font-size: clamp(1.65rem, 4vw, 2.45rem); line-height: 1.15; }
    .hero p { margin: 8px 0 0; opacity: .92; }
    .hero .group-credit {
      margin-top: 16px; padding: 11px 14px; border-radius: 10px;
      background: rgba(255, 255, 255, .14); border: 1px solid rgba(255, 255, 255, .24);
      font-size: .94rem;
    }
    .panel {
      background: var(--card); border: 1px solid var(--line); border-radius: 18px;
      padding: 22px; margin-top: 18px; box-shadow: 0 7px 22px rgba(25, 43, 80, .045);
    }
    h2 { margin: 0 0 12px; font-size: 1.2rem; }
    .hint { color: var(--muted); font-size: .94rem; margin-top: 0; }
    .audio-box { border: 1.5px dashed #b8c4e8; background: #f8f9ff; padding: 16px; border-radius: 14px; }
    input[type="file"] { display: block; width: 100%; margin: 8px 0 12px; }
    audio { display: block; width: 100%; margin-top: 12px; }
    .status { color: var(--muted); font-size: .9rem; }
    .audio-apology{margin:12px 0 0;text-align:center;font-size:.82rem;letter-spacing:.025em;color:#4f9ab4;font-style:italic;animation:sparkle 2.2s ease-in-out infinite}
    @keyframes sparkle{0%,100%{opacity:.72;text-shadow:0 0 2px #b9eaf7}50%{opacity:1;text-shadow:0 0 8px #8bd8ef,0 0 13px #c5f4e5}}
    body.dark .audio-apology{color:#a9e7f6}
    .question { padding: 18px 0; border-bottom: 1px solid var(--line); }
    .question:last-child { border-bottom: 0; padding-bottom: 0; }
    .q-title { font-weight: 700; margin: 0 0 11px; }
    .option {
      display: flex; align-items: flex-start; gap: 10px; padding: 10px 12px; margin: 7px 0;
      border: 1px solid var(--line); border-radius: 11px; cursor: pointer; transition: .15s ease;
    }
    .option:hover { border-color: #a9b7ef; background: #fafbff; }
    .option input { margin-top: 5px; accent-color: var(--primary); }
    .option.correct { border-color: #8dd4ac; background: var(--good-bg); }
    .option.incorrect { border-color: #f0aaa5; background: var(--bad-bg); }
    .feedback { font-size: .92rem; margin-top: 10px; padding: 10px 12px; border-radius: 10px; color: var(--ink); background: #f5f7fc; }
    .transcript { line-height: 1.9; }
    .transcript p { margin: 10px 0; }
    .transcript mark { background: #ffeb70; color: #252525; padding: 2px 4px; border-radius: 4px; }
    .transcript .speaker { font-weight: 700; color: var(--primary); }
    .transcript-note { background: #fff9db; border: 1px solid #f0df8a; padding: 12px; border-radius: 10px; font-size: .9rem; }
    .actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 20px; }
    button {
      border: 0; border-radius: 11px; padding: 12px 18px; font-size: .98rem; font-weight: 700;
      cursor: pointer;
    }
    .primary { background: var(--primary); color: white; }
    .primary:hover { background: var(--primary-dark); }
    .secondary { background: #edf0f7; color: var(--ink); }
    button:focus-visible, input:focus-visible { outline: 3px solid #aab8ff; outline-offset: 2px; }
    #result { display: none; }
    .vocab-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 12px; }
    .vocab-item { border: 1px solid var(--line); border-radius: 12px; padding: 13px; background: #fbfcff; }
    .vocab-item strong { color: var(--primary); }
    .vocab-item p { margin: 5px 0 0; }
    .score { font-size: 2rem; font-weight: 800; color: var(--primary); margin: 2px 0; }
    .result-note { color: var(--muted); margin: 0; }
    .footer { text-align: center; color: var(--muted); font-size: .85rem; padding: 24px 8px 0; }
    @media (max-width: 600px) {
      .page { width: min(100% - 18px, 920px); margin-top: 12px; }
      .hero, .panel { padding: 18px; border-radius: 15px; }
    }

    /* Clear sky-blue + mint theme for stronger contrast */
    :root{--bg:#f1f8fc;--card:#ffffff;--ink:#203746;--muted:#526b7a;--primary:#287da5;--primary-dark:#1e6385;--line:#d5e6ee;--good:#17643c;--good-bg:#e5f7ec;--bad:#a32335;--bad-bg:#fff0f1;--shadow:0 10px 28px rgba(37,91,117,.09)}
    body{background:radial-gradient(circle at 8% 4%,#d8effa 0,transparent 29%),radial-gradient(circle at 95% 18%,#dcf6ed 0,transparent 25%),var(--bg);font-family:'Trebuchet MS',Arial,sans-serif;transition:background .25s,color .25s;color:var(--ink)}
    .page{max-width:960px;margin:24px auto 40px}
    .hero{position:relative;overflow:hidden;padding:34px;border-radius:24px;color:#173e52;background:linear-gradient(135deg,#d5f0fb,#eaf8fc 55%,#d9f5e9);border:1px solid #c5e5f0;box-shadow:0 14px 34px rgba(37,111,143,.13)}
    .hero:after{content:'🐰 ✦ ♡';position:absolute;right:24px;top:18px;font-size:clamp(1.8rem,5vw,3.4rem);opacity:.9;transform:rotate(7deg);pointer-events:none}
    .eyebrow{color:#246d91;opacity:1;letter-spacing:.12em}.hero h1{color:#174e6a}.hero p{color:#294f61}.hero .group-credit{background:rgba(255,255,255,.72);border:1px solid rgba(255,255,255,.95);border-radius:14px;color:#294f61}
    .panel{background:rgba(255,255,255,.97);border:1px solid var(--line);border-radius:20px;padding:24px;margin-top:18px;box-shadow:var(--shadow);animation:floatIn .4s ease both}
    h2{color:#216d91}.hint{color:var(--muted)}.audio-box{border:1.5px dashed #8ec9df;background:#f2fbff;border-radius:16px}.status{color:#456b7b}
    .option{background:#fff;border-color:#d5e6ee;border-radius:13px;padding:12px 14px;transition:transform .18s,border-color .18s,background .18s}.option:hover{border-color:#69b5d1;background:#eff9fd;transform:translateY(-1px)}.option.correct{background:var(--good-bg);border-color:#8dd4ac}.option.incorrect{background:var(--bad-bg);border-color:#e7a1aa}
    button{border-radius:999px;transition:transform .18s,box-shadow .18s}button:hover{transform:translateY(-1px);box-shadow:0 5px 14px rgba(37,111,143,.14)}.primary{background:linear-gradient(135deg,#328eb5,#26779e);color:white}.primary:hover{background:linear-gradient(135deg,#26779e,#1d6488)}.secondary{background:#eaf6fb;color:#215e7a;border:1px solid #c6e4ef}
    .transcript-note{background:#fff8d9;border-color:#eadb8d;border-radius:13px}.transcript mark{background:#ffe78a;color:#252525}.transcript .speaker{color:#216d91}.vocab-item{border-color:#d5e8ef;background:linear-gradient(145deg,#fff,#f3fbfd);border-radius:15px;position:relative}.vocab-item strong{color:#216d91}.score{color:#267da5}.feedback{border-radius:13px;background:#f1f9fc;border:1px solid #d4e8f0}
    .top-tools{display:flex;justify-content:flex-end;gap:8px;margin-bottom:10px}.tool-btn{background:#fff;border:1px solid #cfe4ec;color:#245e78;padding:9px 13px;font-size:.9rem}
    .progress-wrap{margin:8px 0 20px;padding:13px 15px;background:#f1f9fc;border:1px solid #d1e7ef;border-radius:15px}.progress-meta{display:flex;justify-content:space-between;gap:10px;font-size:.9rem;color:#315f73;margin-bottom:8px;font-weight:700}.progress-track{height:9px;border-radius:99px;background:#dceef4;overflow:hidden}.progress-fill{height:100%;width:0;background:linear-gradient(90deg,#74c9dc,#4eb99e);border-radius:99px;transition:width .3s ease}
