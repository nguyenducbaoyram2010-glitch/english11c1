    body.dark{--bg:#17252e;--card:#233640;--ink:#eef7fb;--muted:#bdd0d9;--line:#3e5965;--primary:#77c8e4;--primary-dark:#55afd0;--good-bg:#1e3b2d;--bad-bg:#482b32;background:radial-gradient(circle at 8% 4%,#254654 0,transparent 30%),#17252e;color:var(--ink)}body.dark .panel{background:rgba(35,54,64,.97);border-color:#3e5965}body.dark .hero{background:linear-gradient(135deg,#244d60,#29434b);border-color:#426b78;color:#eefaff}body.dark .hero h1,body.dark .hero p,body.dark .hero .group-credit{color:#eefaff}body.dark .hero .group-credit{background:#315462;border-color:#527786}body.dark h2{color:#9ddcf0}body.dark .audio-box,body.dark .progress-wrap,body.dark .feedback{background:#293f49;border-color:#46636f}body.dark .option,body.dark .vocab-item{background:#2a404a;border-color:#46616d;color:#eef7fb}body.dark .option:hover{background:#34525f}body.dark .secondary,body.dark .tool-btn{background:#304b57;color:#e3f7ff;border-color:#527381}body.dark .progress-track{background:#405b66}body.dark .transcript-note{background:#4b4329;border-color:#76683b;color:#fff1c7}body.dark .transcript mark{color:#352817}body.dark .save-word{background:#304b57;color:#e3f7ff;border-color:#527381}
