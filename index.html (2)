    @keyframes floatIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
    @media(max-width:600px){.page{width:calc(100% - 18px);margin-top:12px}.hero,.panel{padding:18px;border-radius:17px}.hero:after{right:12px;top:12px;font-size:1.8rem}.top-tools{justify-content:stretch}.tool-btn{flex:1}.progress-meta{font-size:.82rem}}

